# BioRxiv Daily - 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ============================================
# Supabase 配置 (必需)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# 可选功能开关
# ============================================
# 是否显示机构信息
VITE_SHOW_INSTITUTIONS=true

# 禁用标签RPC（使用备用方案）
VITE_DISABLE_TAGS_RPC=false

# 禁用管理员验证（开发环境用）
VITE_DISABLE_ADMIN_VERIFY=false

# 应用名称
VITE_APP_NAME=BioRxiv日报

# 开发模式
VITE_DEV_MODE=false

# ============================================
# Vercel Functions 环境变量 (部署到 Vercel 时需要)
# ============================================
# DeepSeek AI API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase 服务端配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# ============================================
# Supabase Edge Functions 环境变量
# 在 Supabase Dashboard > Settings > API 中配置
# ============================================
# DeepSeek 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 可选：百度翻译（快速翻译方案）
# BAIDU_APP_ID=your-baidu-app-id
# BAIDU_SECRET_KEY=your-baidu-secret-key

# 可选：MiniMax（全文分析）
# MINIMAX_API_KEY=your-minimax-key
# MINIMAX_API_URL=https://api.minimax.chat/v1/text/chatcompletion

# ============================================
# 获取环境变量的方法：
# ============================================
# 1. Supabase:
#    - 访问 https://supabase.com/dashboard
#    - 进入你的项目 > Project Settings > API
#    - 复制 URL 和 anon/public key
#
# 2. DeepSeek:
#    - 访问 https://platform.deepseek.com/
#    - 创建 API Key
#
# 3. Vercel:
#    - 访问 https://vercel.com/dashboard
#    - 进入项目 > Settings > Environment Variables
#    - 添加上述所有变量
